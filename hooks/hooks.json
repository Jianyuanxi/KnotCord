{
  "description": "KnotCord 记忆插件：开局注入、收尾、增量入库。所有 hook 只写日志，永远 exit 0。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "D:\\Anaconda\\python.exe",
            "args": [
              "-I",
              "-S",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/knotcord/hooks/entry.py",
              "session-start"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:\\Anaconda\\python.exe",
            "args": [
              "-I",
              "-S",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/knotcord/hooks/entry.py",
              "prompt"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:knotcord:knotcord",
            "tool": "ingest",
            "input": {
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "last": "${last_assistant_message}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:knotcord:knotcord",
            "tool": "ingest",
            "input": {
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D:\\Anaconda\\python.exe",
            "args": [
              "-I",
              "-S",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/knotcord/hooks/entry.py",
              "session-end"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
